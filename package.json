{
  "name": "@johnmorrisdotca/kumimoji",
  "version": "1.2.0",
  "description": "Crossword tile race: a word game engine where each player builds a crossword from a bag of letter tiles, in English or Japanese kana, alone against the clock or at a table of two to eight. Seeded deals, word checking, wild tiles, a computer player, and a playable table for React, Vue, Svelte, Angular or plain HTML. Zero dependencies.",
  "keywords": [
    "word-game",
    "custom-element",
    "web-component",
    "word-puzzle",
    "crossword",
    "crossword-game",
    "crossword-builder",
    "tile-game",
    "letter-tiles",
    "tiles",
    "word-tiles",
    "anagram",
    "anagrams",
    "word-race",
    "spelling",
    "vocabulary",
    "dictionary",
    "word-list",
    "word-check",
    "word-validation",
    "english",
    "japanese",
    "kana",
    "hiragana",
    "nihongo",
    "language-learning",
    "scowl",
    "jmdict",
    "wild-tiles",
    "blank-tiles",
    "game",
    "game-engine",
    "rules-engine",
    "game-logic",
    "puzzle",
    "puzzle-generator",
    "seeded",
    "deterministic",
    "prng",
    "ai",
    "computer-player",
    "bot",
    "multiplayer",
    "pass-and-play",
    "hotseat",
    "party-game",
    "save-game",
    "json",
    "export",
    "import",
    "browser-game",
    "html5-game",
    "typescript",
    "javascript",
    "esm",
    "react",
    "react-component",
    "vue",
    "svelte",
    "angular",
    "vanilla-js",
    "dom",
    "i18n",
    "theming",
    "dark-mode",
    "zero-dependencies"
  ],
  "homepage": "https://johnmorrisdotca.github.io/kumimoji/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/kumimoji/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kumimoji.git"
  },
  "license": "MIT AND CC-BY-SA-4.0",
  "author": {
    "name": "John Morris",
    "email": "john@johnmorris.ca",
    "url": "https://johnmorris.ca"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./words": {
      "types": "./dist/words.d.ts",
      "default": "./dist/words.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "default": "./dist/element-define.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "./dist/words.js",
    "./dist/tileWordsModule.js",
    "./dist/element-define.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:table": "pnpm site && playwright test",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "test:frameworks": "pnpm build && node scripts/check-frameworks.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "pictures": "pnpm site && node scripts/readme-pictures.mjs",
    "docs:make": "node scripts/docs.mjs",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
